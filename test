Put this in something like:

tests/integration/test_summarization_mlflow.py
import sqlite3

import mlflow
import pandas as pd
import pytest
from mlflow.models import infer_signature

from summarizer import run_pipeline
from mlflow_utils import log_transformer_model


@pytest.mark.integration
def test_summarization_prediction_sqlite_and_schema(
    mlflow_server,
    tmp_path,
):
    """
    Verify summarization prediction is stored in SQLite,
    loaded through MLflow, and returned with the expected schema.
    """

    # ---------------------------------------------------------
    # 1. Input for YOUR actual summarization pipeline
    # ---------------------------------------------------------
    combined_text = (
        "This is a sample document for testing the summarization "
        "pipeline. It contains information that should be summarized."
    )

    # ---------------------------------------------------------
    # 2. Run YOUR actual summarization pipeline
    # ---------------------------------------------------------
    summary_results, models = run_pipeline(
        combined_text
    )

    assert summary_results
    assert models

    # ---------------------------------------------------------
    # 3. Create SQLite DB for prediction results
    # ---------------------------------------------------------
    prediction_db = (
        tmp_path / "summarization_predictions.db"
    )

    conn = sqlite3.connect(prediction_db)

    conn.execute(
        """
        CREATE TABLE predictions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            input_text TEXT NOT NULL,
            model_name TEXT NOT NULL,
            prediction TEXT NOT NULL
        )
        """
    )

    # ---------------------------------------------------------
    # 4. Store YOUR actual summarization results
    # ---------------------------------------------------------
    for model_name, prediction in summary_results.items():

        conn.execute(
            """
            INSERT INTO predictions
                (input_text, model_name, prediction)
            VALUES (?, ?, ?)
            """,
            (
                combined_text,
                model_name,
                str(prediction),
            ),
        )

    conn.commit()
    conn.close()

    # ---------------------------------------------------------
    # 5. Verify SQLite storage
    # ---------------------------------------------------------
    conn = sqlite3.connect(prediction_db)

    stored_df = pd.read_sql_query(
        """
        SELECT input_text, model_name, prediction
        FROM predictions
        """,
        conn,
    )

    conn.close()

    assert not stored_df.empty
    assert len(stored_df) == len(summary_results)

    # ---------------------------------------------------------
    # 6. Create MLflow experiment
    # ---------------------------------------------------------
    mlflow.set_experiment(
        "summarization-integration-test"
    )

    # ---------------------------------------------------------
    # 7. Start REAL MLflow server run
    # ---------------------------------------------------------
    with mlflow.start_run(
        run_name="summarization_sqlite_test"
    ) as run:

        run_id = run.info.run_id

        # -----------------------------------------------------
        # 8. Log YOUR actual transformer models
        # -----------------------------------------------------
        for model_name, model_pipeline in models.items():

            model_input = pd.DataFrame(
                {
                    "text": [combined_text]
                }
            )

            # Actual prediction from YOUR model
            raw_prediction = model_pipeline(
                combined_text
            )

            prediction_df = pd.DataFrame(
                {
                    "prediction": [
                        raw_prediction[0]["summary_text"]
                    ]
                }
            )

            # -------------------------------------------------
            # 9. Create MLflow signature
            # -------------------------------------------------
            signature = infer_signature(
                model_input,
                prediction_df,
            )

            # -------------------------------------------------
            # 10. Log YOUR model using YOUR utility
            # -------------------------------------------------
            logged = log_transformer_model(
                model_name=model_name,
                model_pipeline=model_pipeline,
                signature=signature,
            )

            assert logged is True

            # -------------------------------------------------
            # 11. Build model URI
            # -------------------------------------------------
            model_uri = (
                f"runs:/{run_id}/{model_name}"
            )

            # -------------------------------------------------
            # 12. Load model from MLflow server
            # -------------------------------------------------
            loaded_model = mlflow.pyfunc.load_model(
                model_uri
            )

            # -------------------------------------------------
            # 13. Read input back from SQLite
            # -------------------------------------------------
            conn = sqlite3.connect(
                prediction_db
            )

            sqlite_input = pd.read_sql_query(
                """
                SELECT input_text
                FROM predictions
                WHERE model_name = ?
                """,
                conn,
                params=(model_name,),
            )

            conn.close()

            sqlite_input = sqlite_input.rename(
                columns={
                    "input_text": "text"
                }
            )

            # -------------------------------------------------
            # 14. Predict using MLflow-loaded model
            # -------------------------------------------------
            result = loaded_model.predict(
                sqlite_input
            )

            # -------------------------------------------------
            # 15. Schema assertions
            # -------------------------------------------------
            assert isinstance(
                result,
                pd.DataFrame,
            )

            assert list(
                result.columns
            ) == ["prediction"]

            assert result[
                "prediction"
            ].notna().all()

            assert len(result) == 1

            # -------------------------------------------------
            # 16. Verify prediction was actually generated
            # -------------------------------------------------
            assert isinstance(
                result.iloc[0]["prediction"],
                str,
            )
