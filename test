class FakeTokenizer:
    def __call__(
        self,
        text,
        truncation=False,
        max_length=None,
        add_special_tokens=True,
    ):
        # Simple whitespace tokenization
        tokens = text.split()

        if truncation and max_length:
            tokens = tokens[:max_length]

        return {
            "input_ids": list(range(len(tokens)))
        }

    def decode(
        self,
        input_ids,
        skip_special_tokens=True,
    ):
        return " ".join(
            f"token_{i}" for i in input_ids
        )


class FakeSummarizationPipeline:

    def __init__(self):
        self.tokenizer = FakeTokenizer()

    def __call__(
        self,
        text,
        max_new_tokens=None,
        min_length=None,
        truncation=True,
        do_sample=False,
        length_penalty=1.2,
        early_stopping=True,
        no_repeat_ngram_size=3,
        **kwargs,
    ):
        words = text.split()

        # Deterministic fake summary
        summary_length = min(20, len(words))

        summary = " ".join(
            words[:summary_length]
        )

        return [
            {
                "summary_text": (
                    f"FAKE SUMMARY: {summary}"
                )
            }


