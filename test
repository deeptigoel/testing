```python
import pandas as pd
import mlflow

import mlflow_utils


def test_mlflow_run_metadata_and_input_output_artifacts(
    monkeypatch,
    mlflow_server,
    tmp_path,
):
    # ------------------------------------------------------------------
    # 1. Configure MLflow to use the local test server
    # ------------------------------------------------------------------

    mlflow.set_tracking_uri(mlflow_server)

    monkeypatch.setattr(
        mlflow_utils,
        "MLFLOW_REGISTRY_URI",
        mlflow_server,
    )

    config = mlflow_utils.configure_mlflow()

    assert config["tracking_uri"] == mlflow_server
    assert config["use_unity_catalog"] is False

    # ------------------------------------------------------------------
    # 2. Create test input
    #
    # Use the same basic columns expected by the actual
    # summarization pipeline:
    # product
    # therapeutic_area
    # ingestion_date
    # TEXT
    # ------------------------------------------------------------------

    df = pd.DataFrame(
        {
            "product": ["ABC", "ABC"],
            "therapeutic_area": [
                "Respiratory",
                "Respiratory",
            ],
            "ingestion_date": [
                "2025-06-01",
                "2025-06-15",
            ],
            "TEXT": [
                "This is the first test document.",
                "This is the second test document.",
            ],
        }
    )

    # ------------------------------------------------------------------
    # 3. Create physical input file
    #
    # The actual pipeline logs input.xlsx as an artifact.
    # ------------------------------------------------------------------

    input_file = tmp_path / "input.xlsx"

    df.to_excel(
        input_file,
        index=False,
    )

    # ------------------------------------------------------------------
    # 4. Create deterministic summary output
    #
    # We do NOT call the real Hugging Face summarization pipeline here.
    # This test is verifying MLflow logging and artifact integration.
    # ------------------------------------------------------------------

    summary_results = {
        "test_model": (
            "This is the generated summary "
            "for the test documents."
        )
    }

    summary_output_df = df.copy()

    summary_output_df["summary"] = [
        "Summary of the first test document.",
        "Summary of the second test document.",
    ]

    output_file = tmp_path / "summary.xlsx"

    summary_output_df.to_excel(
        output_file,
        index=False,
    )

    # ------------------------------------------------------------------
    # 5. Start PARENT MLflow run
    # ------------------------------------------------------------------

    with mlflow.start_run(
        run_name="integration_test"
    ) as parent_run:

        parent_run_id = parent_run.info.run_id

        # --------------------------------------------------------------
        # 6. Log parent-run tags
        # --------------------------------------------------------------

        mlflow_utils.set_run_tags(
            description="MLflow integration test",
            product="ABC",
            run_type="inference",
            run_scope="summarization_pipeline",
            run_id=parent_run_id,
            capability="abstractive summarization",
            dataset_version="test_v1",
            git_sha="test-sha",
        )

        # --------------------------------------------------------------
        # 7. Log environment
        # --------------------------------------------------------------

        mlflow_utils.log_environment()

        # --------------------------------------------------------------
        # 8. Log parameters
        # --------------------------------------------------------------

        mlflow_utils.log_parameters(
            {
                "chunk_size": 4000,
                "batch_size": 2,
                "max_length": 3000,
                "min_tokens": 100,
            }
        )

        # --------------------------------------------------------------
        # 9. Log MLflow DATASET INPUT
        #
        # Same mechanism used in the actual pipeline.
        # --------------------------------------------------------------

        dataset = mlflow.data.from_pandas(
            df,
            source=str(input_file),
            name="summarization_input",
        )

        mlflow.log_input(
            dataset,
            context="inference",
        )

        # --------------------------------------------------------------
        # 10. Log physical INPUT artifact
        #
        # Same artifact path used by the actual pipeline.
        # --------------------------------------------------------------

        mlflow_utils.log_artifact(
            str(input_file),
            artifact_path="input",
        )

        # --------------------------------------------------------------
        # 11. Log SUMMARY OUTPUT artifact
        #
        # The actual pipeline saves the summary output and then
        # logs the resulting file as an MLflow artifact.
        # --------------------------------------------------------------

        mlflow_utils.log_artifact(
            str(output_file),
            artifact_path="output",
        )

        # --------------------------------------------------------------
        # 12. Start EVALUATION child run
        # --------------------------------------------------------------

        with mlflow.start_run(
            run_name="Evaluation",
            nested=True,
        ) as evaluation_run:

            evaluation_run_id = (
                evaluation_run.info.run_id
            )

            # ----------------------------------------------------------
            # 13. Evaluation-run tags
            # ----------------------------------------------------------

            mlflow_utils.set_run_tags(
                description="Evaluation Metrics",
                product="ABC",
                run_type="evaluation",
                run_scope="scoring",
                run_id=evaluation_run_id,
                capability="abstractive summarization",
                dataset_version="test_v1",
                git_sha="test-sha",
            )

            # ----------------------------------------------------------
            # 14. Evaluation metrics
            # ----------------------------------------------------------

            mlflow.log_metric(
                "rougeL",
                0.80,
            )

            mlflow.log_metric(
                "bert_f1",
                0.85,
            )

            mlflow.log_metric(
                "meteor",
                0.75,
            )

            mlflow.log_metric(
                "factual_consistency",
                0.90,
            )

    # ==================================================================
    # 15. Read PARENT run back from MLflow
    # ==================================================================

    stored_parent_run = mlflow.get_run(
        parent_run_id
    )

    assert stored_parent_run.info.status == "FINISHED"

    # ------------------------------------------------------------------
    # 16. Verify parameters
    # ------------------------------------------------------------------

    assert (
        stored_parent_run.data.params["chunk_size"]
        == "4000"
    )

    assert (
        stored_parent_run.data.params["batch_size"]
        == "2"
    )

    assert (
        stored_parent_run.data.params["max_length"]
        == "3000"
    )

    assert (
        stored_parent_run.data.params["min_tokens"]
        == "100"
    )

    # ------------------------------------------------------------------
    # 17. Verify environment parameters
    # ------------------------------------------------------------------

    assert "platform" in stored_parent_run.data.params

    # ------------------------------------------------------------------
    # 18. Verify parent tags
    # ------------------------------------------------------------------

    assert (
        stored_parent_run.data.tags["run_type"]
        == "inference"
    )

    assert (
        stored_parent_run.data.tags["run_scope"]
        == "summarization_pipeline"
    )

    assert (
        stored_parent_run.data.tags["capability"]
        == "abstractive summarization"
    )

    assert (
        stored_parent_run.data.tags["dataset_version"]
        == "test_v1"
    )

    assert (
        stored_parent_run.data.tags["git_sha"]
        == "test-sha"
    )

    # ==================================================================
    # 19. Verify MLflow DATASET INPUT
    # ==================================================================

    dataset_inputs = (
        stored_parent_run.inputs.dataset_inputs
    )

    assert len(dataset_inputs) == 1

    dataset_input = dataset_inputs[0]

    assert (
        dataset_input.dataset.name
        == "summarization_input"
    )

    assert any(
        tag.key == "mlflow.data.context"
        and tag.value == "inference"
        for tag in dataset_input.tags
    )

    # ==================================================================
    # 20. Verify physical INPUT artifact
    # ==================================================================

    client = mlflow.MlflowClient()

    input_artifacts = client.list_artifacts(
        parent_run_id,
        path="input",
    )

    assert any(
        artifact.path.endswith("input.xlsx")
        for artifact in input_artifacts
    )

    # ==================================================================
    # 21. Verify SUMMARY OUTPUT artifact
    # ==================================================================

    output_artifacts = client.list_artifacts(
        parent_run_id,
        path="output",
    )

    assert any(
        artifact.path.endswith("summary.xlsx")
        for artifact in output_artifacts
    )

    # ==================================================================
    # 22. Read EVALUATION run back from MLflow
    # ==================================================================

    stored_evaluation_run = mlflow.get_run(
        evaluation_run_id
    )

    assert (
        stored_evaluation_run.info.status
        == "FINISHED"
    )

    # ------------------------------------------------------------------
    # 23. Verify evaluation metrics
    # ------------------------------------------------------------------

    assert (
        stored_evaluation_run.data.metrics["rougeL"]
        == 0.80
    )

    assert (
        stored_evaluation_run.data.metrics["bert_f1"]
        == 0.85
    )

    assert (
        stored_evaluation_run.data.metrics["meteor"]
        == 0.75
    )

    assert (
        stored_evaluation_run.data.metrics[
            "factual_consistency"
        ]
        == 0.90
    )

    # ------------------------------------------------------------------
    # 24. Verify evaluation tags
    # ------------------------------------------------------------------

    assert (
        stored_evaluation_run.data.tags["run_type"]
        == "evaluation"
    )

    assert (
        stored_evaluation_run.data.tags["run_scope"]
        == "scoring"
    )

    assert (
        stored_evaluation_run.data.tags["capability"]
        == "abstractive summarization"
    )
